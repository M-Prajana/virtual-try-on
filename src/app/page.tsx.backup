                <h3 className="text-2xl font-bold text-gray-900 dark:text-white mb-4">Upload Your Photo</h3>
                <p className="text-gray-600 dark:text-gray-300 leading-relaxed">
                  Take a clear, well-lit photo of yourself. Our AI works best with front-facing images showing your full body.
                </p>
              </div>
              {/* Connector Line */}
              <div className="hidden lg:block absolute top-12 left-full w-full h-0.5 bg-gradient-to-r from-purple-300 to-blue-300 transform -translate-y-1/2" style={{width: 'calc(100% - 6rem)'}}></div>
            </div>

            {/* Step 2 */}
            <div className="relative">
              <div className="text-center">
                <div className="relative inline-block mb-8">
                  <div className="w-24 h-24 bg-gradient-to-r from-blue-500 to-cyan-600 rounded-3xl flex items-center justify-center text-white text-3xl font-bold shadow-lg">
                    2
                  </div>
                  <div className="absolute -inset-2 bg-gradient-to-r from-blue-500 to-cyan-600 rounded-3xl blur-lg opacity-30"></div>
                </div>
                <h3 className="text-2xl font-bold text-gray-900 dark:text-white mb-4">Choose Your Garment</h3>
                <p className="text-gray-600 dark:text-gray-300 leading-relaxed">
                  Upload any clothing item or select from our curated collection. Works with dresses, shirts, jackets, and more.
                </p>
              </div>
              {/* Connector Line */}
              <div className="hidden lg:block absolute top-12 left-full w-full h-0.5 bg-gradient-to-r from-blue-300 to-cyan-300 transform -translate-y-1/2" style={{width: 'calc(100% - 6rem)'}}></div>
            </div>

            {/* Step 3 */}
            <div className="relative">
              <div className="text-center">
                <div className="relative inline-block mb-8">
                  <div className="w-24 h-24 bg-gradient-to-r from-cyan-500 to-green-600 rounded-3xl flex items-center justify-center text-white text-3xl font-bold shadow-lg">
                    3
                  </div>
                  <div className="absolute -inset-2 bg-gradient-to-r from-cyan-500 to-green-600 rounded-3xl blur-lg opacity-30"></div>
                </div>
                <h3 className="text-2xl font-bold text-gray-900 dark:text-white mb-4">Get Instant Results</h3>
                <p className="text-gray-600 dark:text-gray-300 leading-relaxed">
                  Our AI processes your request in seconds, delivering photorealistic results you can download and share.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* CTA Section */}
      <section className="py-24 bg-gradient-to-r from-purple-600 via-blue-600 to-indigo-700">
        <div className="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
